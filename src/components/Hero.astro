---
import Icon from "./Icon.astro";
import heroHuevos from "../assets/huevos-frescos-mamay.jpg";
import { getWhatsAppUrl } from "../config/site";

const badges = [
  { icon: "schedule", text: "Recolección fresca < 24h" },
  { icon: "local_shipping", text: "Hogares y Gastronomía" },
  { icon: "verified", text: "Facturación formal RUC 20" },
];
---

<section class="relative w-full py-12 lg:py-20 overflow-hidden">
  <div
    class="contenedor-mamay grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center"
  >
    <div class="lg:col-span-7 flex flex-col items-start gap-6">
      <h1
        class="font-display text-4xl sm:text-5xl lg:text-[54px] lg:leading-[62px] text-primary tracking-tight font-semibold"
      >
        Huevos frescos criados con cariño para nutrir a tu hogar
      </h1>

      <p
        class="text-base lg:text-lg text-on-surface-variant leading-relaxed max-w-2xl"
      >
        Somos la gran <strong class="text-primary font-semibold"
          >Tribu IM+</strong
        >. Seleccionamos diariamente huevos de alta densidad nutricional para
        deleitar a la exigente gastronomía peruana y llenar de vitalidad a las
        familias de Lima y todo el país.
      </p>

      <div class="flex flex-wrap items-center gap-4 pt-2 w-full sm:w-auto">
        <a
          href={getWhatsAppUrl("Hola Granja Mamay, deseo hacer un pedido de huevos frescos")}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-3 px-7 py-4 rounded-xl bg-secondary-container text-on-secondary-container hover:bg-secondary hover:text-white shadow-md hover:shadow-lg transition-all duration-300 text-sm font-bold tracking-wide"
        >
          <Icon name="chat" class="w-5 h-5 shrink-0" />
          <span>Pedir por WhatsApp</span>
          <span
            class="px-2.5 py-0.5 rounded-full bg-surface-lowest/85 text-on-secondary-container text-[10px] font-extrabold uppercase tracking-wider"
          >
            Atención Inmediata
          </span>
        </a>

        <a
          href="#catalogo"
          class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-surface-container hover:bg-outline-variant/40 text-primary text-sm font-semibold transition-colors duration-200"
        >
          <span>Ver Productos y Calibres</span>
          <Icon name="arrow_downward" class="w-4 h-4 shrink-0" />
        </a>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-6 w-full border-t border-outline-variant/30"
      >
        {
          badges.map((item) => (
            <div class="flex items-center gap-2.5">
              <Icon name={item.icon} class="w-5 h-5 text-secondary shrink-0" />
              <span class="text-xs font-medium text-on-surface">
                {item.text}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="lg:col-span-5 relative flex justify-center lg:justify-end">
      <div
        class="absolute -inset-4 bg-gradient-to-tr from-secondary-fixed/30 to-primary-fixed/20 rounded-3xl blur-2xl -z-10"
      >
      </div>

      <div
        class="relative w-full rounded-3xl overflow-hidden shadow-2xl bg-surface-lowest p-2.5"
      >
        <img
          src={heroHuevos.src}
          alt="Cesta artesanal de huevos frescos de campo recolectados en Granja Mamay, Lurín"
          class="w-full h-[420px] lg:h-[460px] object-cover rounded-2xl"
          loading="eager"
          fetchpriority="high"
        />

        <div
          class="absolute top-6 right-6 p-3.5 rounded-2xl bg-surface-lowest/95 backdrop-blur-md shadow-lg max-w-[210px]"
        >
          <div class="flex items-center gap-1.5 mb-1">
            <Icon name="sunny" class="w-4 h-4 text-secondary-container shrink-0" />
            <span class="text-xs font-bold text-primary"
              >Pampa Mamay, Lurín</span
            >
          </div>
          <p class="text-[11px] text-on-surface-variant leading-tight">
            Clima templado del valle ideal para aves de postura libre de estrés.
          </p>
        </div>

        <div
          class="absolute bottom-6 left-6 p-4 rounded-2xl bg-primary text-white shadow-xl max-w-[240px]"
        >
          <div class="flex items-center gap-1.5 mb-1">
            <Icon name="workspace_premium" class="w-4 h-4 text-secondary-container shrink-0" />
            <span class="text-xs font-bold text-white"
              >100% Frescura Garantizada</span
            >
          </div>
          <p class="text-[11px] text-primary-fixed leading-tight">
            Clasificación diaria por peso, calibre parejo y cáscara resistente.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
