---
import Icon from "./Icon.astro";
import { SITE_CONFIG, getWhatsAppUrl } from "../config/site";

const steps = [
  {
    icon: "grain",
    title: "Crianza Sana y Confortable",
    desc: "Nutrición balanceada con maíz y granos seleccionados en galpones que aprovechan la brisa y luz solar de Lurín.",
  },
  {
    icon: "egg",
    title: "Recolección Matutina",
    desc: "Cosecha manual y cuidadosa a primera hora del día, garantizando que el producto no permanezca almacenado por días.",
  },
  {
    icon: "balance",
    title: "Clasificación Tecnificada",
    desc: "Inspección visual de integridad de cáscara y categorización milimétrica por calibres de peso uniforme.",
  },
  {
    icon: "local_shipping",
    title: "Despacho Inmediato",
    desc: "Embalaje protegido en maples o cajas maestras con entrega oportuna en Lima Sur y Lima Metropolitana.",
  },
];

const businessBenefits = [
  {
    icon: "calendar_today",
    title: "Abastecimiento",
    desc: "Suministro garantizado todo el año sin roturas de stock ni variaciones arbitrarias.",
  },
  {
    icon: "savings",
    title: "Costo Directo",
    desc: "Tarifas mayoristas de primer orden y condiciones de crédito para aliados frecuentes.",
  },
  {
    icon: "badge",
    title: "Formalidad",
    desc: "Inversiones Mamay E.I.R.L. con facturación electrónica al 100% y RUC 20 activo.",
  },
];
---

<section id="calidad" class="w-full py-20 scroll-mt-24">
  <div class="contenedor-mamay flex flex-col gap-12">
    <div class="max-w-2xl">
      <span
        class="text-[11px] uppercase tracking-widest text-secondary font-bold"
      >
        Trazabilidad Total
      </span>
      <h2
        class="font-display text-3xl sm:text-4xl lg:text-[40px] lg:leading-[48px] text-primary font-semibold mt-2"
      >
        Del Galpón a tu Cocina en 4 Pasos Transparentes
      </h2>
      <p class="text-sm lg:text-base text-on-surface-variant mt-3">
        Cuidamos cada eslabón con disciplina artesanal y control sanitario para
        que abras cada huevo con total tranquilidad.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        steps.map((step, index) => (
          <div class="flex flex-col gap-4 p-6 rounded-2xl bg-surface-low relative">
            <div class="flex items-center justify-between">
              <span class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-bold text-base">
                {index + 1}
              </span>
              <Icon name={step.icon} class="w-7 h-7 text-secondary shrink-0" />
            </div>
            <h3 class="text-lg text-primary font-semibold mt-2">
              {step.title}
            </h3>
            <p class="text-xs text-on-surface-variant leading-relaxed">
              {step.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section
  id="negocios"
  class="w-full bg-primary text-white py-16 lg:py-20 relative overflow-hidden shadow-2xl scroll-mt-20"
>
  <div
    class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-primary-container blur-3xl opacity-50 pointer-events-none"
  >
  </div>
  <div class="contenedor-mamay relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-8 flex flex-col gap-6">
        <div
          class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-secondary-container text-on-secondary-container w-fit text-[11px] font-bold uppercase tracking-wider"
        >
          Canal Gastronómico • Mayorista
        </div>

        <h2
          class="font-display text-3xl sm:text-4xl lg:text-[42px] lg:leading-[50px] font-semibold text-white"
        >
          ¿Tienes un restaurante, panadería o negocio gastronómico en Lima?
        </h2>

        <p
          class="text-base lg:text-lg text-primary-fixed leading-relaxed max-w-3xl"
        >
          Abastecimiento directo desde galpón en el Valle de Lurín, con
          calibración estandarizada por gramaje, frescura insuperable de menos
          de 24 horas y formalidad comercial garantizada.
        </p>

        <div
          class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-outline-variant/20"
        >
          {
            businessBenefits.map((benefit) => (
              <div class="flex flex-col gap-1.5">
                <span class="text-base text-secondary-dim font-bold flex items-center gap-2">
                  <Icon name={benefit.icon} class="w-5 h-5 shrink-0" />
                  {benefit.title}
                </span>
                <p class="text-xs text-primary-fixed leading-relaxed">
                  {benefit.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="lg:col-span-4 flex flex-col items-start lg:items-end justify-center w-full"
      >
        <div
          class="p-8 rounded-3xl bg-surface-lowest/10 backdrop-blur-md border border-outline-variant/30 w-full flex flex-col gap-5 shadow-xl"
        >
          <div class="flex flex-col gap-1">
            <span class="text-lg text-white font-bold"
              >Atención y Cotización Directa</span
            >
            <span class="text-xs text-primary-fixed"
              >Asesoría y despacho para restaurantes y negocios</span
            >
          </div>

          <a
            href={getWhatsAppUrl("Hola Granja Mamay, tenemos un negocio y deseamos cotizar abastecimiento mayorista")}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-4 px-6 rounded-xl bg-secondary-container text-on-secondary-container hover:bg-secondary hover:text-white text-sm font-bold flex items-center justify-center gap-3 transition-colors shadow-lg"
          >
            <Icon name="contact_phone" class="w-5 h-5 shrink-0" />
            <span>Hablar con Asesor Mayorista</span>
          </a>

          <div
            class="flex items-center justify-center gap-2 text-primary-fixed text-xs pt-1"
          >
            <Icon name="call" class="w-4 h-4 shrink-0" />
            <span>WhatsApp: {SITE_CONFIG.phoneDisplay}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
