---
import Icon from "./Icon.astro";
import { SITE_CONFIG, getWhatsAppUrl } from "../config/site";

const links = [
  { name: "Nosotros", href: "#nosotros" },
  { name: "Productos", href: "#catalogo" },
  { name: "Calidad", href: "#calidad" },
  { name: "Para Negocios", href: "#negocios" },
  { name: "Preguntas", href: "#preguntas" },
];
---

<aside
  class="hidden md:block w-full bg-primary-container text-primary-fixed border-b border-outline-variant/20 text-xs py-2"
>
  <div
    class="contenedor-mamay flex flex-wrap items-center justify-between gap-2 text-center sm:text-left"
  >
    <span
      >📍 Granja en Pampa Mamay, Lurín (Km 37.5) • Despachos a todo Lima</span
    >
    <span>
      Atención y Pedidos WhatsApp:{" "}
      <a
        href={getWhatsAppUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-white underline hover:text-secondary-dim transition-colors"
      >
        {SITE_CONFIG.phoneShort}
      </a>
    </span>
  </div>
</aside>

<header
  class="sticky top-0 z-50 w-full bg-surface/95 backdrop-blur-xl border-b border-outline-variant/30 shadow-[0_1px_8px_rgba(0,0,0,0.04)]"
>
  <div class="contenedor-mamay h-16 md:h-20 flex items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-2.5 md:gap-3 shrink-0 group">
      <img
        src="/mamay.svg"
        alt="Logo Granja Mamay"
        class="w-9 h-9 md:w-11 md:h-11 object-contain drop-shadow-sm group-hover:scale-105 transition-transform duration-200"
      />
      <div class="flex flex-col">
        <span
          class="font-display text-lg md:text-xl font-semibold tracking-tight text-primary leading-none"
        >
          {SITE_CONFIG.businessName}
        </span>
        <span
          class="text-[10px] md:text-[11px] uppercase tracking-widest text-secondary font-bold mt-1"
        >
          Lurín • Lima
        </span>
      </div>
    </a>

    <nav
      class="hidden md:flex items-center gap-8 text-sm font-medium text-on-surface-variant"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="hover:text-primary transition-colors flex items-center gap-1.5"
          >
            <span>{link.name}</span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href={getWhatsAppUrl("Hola Granja Mamay, deseo cotizar un pedido")}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 md:px-5 md:py-2.5 rounded-xl bg-secondary-container text-on-secondary-container hover:bg-secondary hover:text-white shadow-sm transition-all duration-200 text-xs md:text-sm font-bold tracking-wide"
      >
        <Icon name="chat" class="w-4 h-4 shrink-0 md:hidden" />
        <span>Cotizar<span class="hidden sm:inline"> Pedido</span></span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-xl bg-surface-container text-primary hover:bg-outline-variant/40 transition-colors cursor-pointer"
      >
        <span id="icon-menu-open">
          <Icon name="menu" class="w-5 h-5" />
        </span>
        <span id="icon-menu-close" class="hidden">
          <Icon name="close" class="w-5 h-5" />
        </span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Navegación móvil"
    class="hidden md:hidden w-full bg-surface border-t border-outline-variant/30 shadow-xl"
  >
    <div class="contenedor-mamay py-4 flex flex-col gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link px-3 py-3 rounded-xl text-sm font-semibold text-primary hover:bg-surface-container transition-colors flex items-center justify-between"
          >
            <span>{link.name}</span>
            <Icon name="expand_more" class="w-4 h-4 -rotate-90 text-secondary" />
          </a>
        ))
      }

      <div class="mt-2 pt-3 border-t border-outline-variant/30 flex flex-col gap-2 px-3 text-xs text-on-surface-variant">
        <span>📍 Pampa Mamay, Lurín (Km 37.5) • Despachos a Lima</span>
        <a
          href={getWhatsAppUrl("Hola Granja Mamay, deseo cotizar un pedido")}
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-secondary flex items-center gap-1.5"
        >
          <Icon name="call" class="w-4 h-4 shrink-0" />
          <span>WhatsApp Directo: {SITE_CONFIG.phoneDisplay}</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-menu-open");
  const iconClose = document.getElementById("icon-menu-close");
  const navLinks = document.querySelectorAll(".mobile-nav-link");

  function toggleMenu(forceClose = false) {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    const isExpanded = btn.getAttribute("aria-expanded") === "true";
    const nextState = forceClose ? false : !isExpanded;

    btn.setAttribute("aria-expanded", String(nextState));
    menu.classList.toggle("hidden", !nextState);
    iconOpen.classList.toggle("hidden", nextState);
    iconClose.classList.toggle("hidden", !nextState);
  }

  btn?.addEventListener("click", () => toggleMenu());
  navLinks.forEach((link) => {
    link.addEventListener("click", () => toggleMenu(true));
  });
</script>
